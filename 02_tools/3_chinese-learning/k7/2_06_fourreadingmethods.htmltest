];
const TR = [
 {
  "t": "余光中〈開卷如開芝麻門〉",
  "p": "讀書其實只是交友的延長。我們交友，只能以時人為對象，而且朋友的數量畢竟有限。但是靠了書籍，我們可以廣交異時和異地的朋友，要說擇友，那就更自由了。一個人的經驗當然以親身得來的最為真切可靠，可是直接的經驗畢竟有限。讀書，正是吸收間接的經驗。生活至上論者說讀書是逃避現實，其實讀書是擴大現實，擴大我們的精神世界。……／在知識爆炸的現代，書，是絕對讀不完的，如果讀書不得其法，則一味多讀也並無意義。……不過，知識爆炸不一定就是智慧增高。我相信，今人的知識一定勝過古人，但智慧則未必。新知識往往比舊知識豐富、正確，但是真正的智慧卻難分新舊。知識，只要收到就行了。智慧卻需要再三玩味，反覆咀嚼，不斷印證。",
  "n": "",
  "qs": [
   {
    "q": "「靠了書籍，我們可以廣交異時和異地的朋友。」這段文字的含義為何？",
    "o": [
     "參與讀書會能結交來自各地愛閱讀的朋友",
     "不論在何時何地閱讀，都能讓人有所收穫",
     "靠讀書得以了解來自不同時代與地方的作者觀點",
     "討論喜愛的書籍能維繫異時異地的友情"
    ],
    "a": 2,
    "e": "藉由閱讀不同時代、地方作者的作品，就像廣交朋友一般。"
   },
   {
    "q": "關於本文的內容，下列敘述何者正確？",
    "o": [
     "沉浸在書中世界是逃避現實的做法",
     "智慧的增長須歷經思考、沉澱的過程",
     "新知識雖然種類豐富，但內容常被推翻",
     "古人的知識較舊，其智慧卻遠勝今人"
    ],
    "a": 1,
    "e": "文中說智慧需要再三玩味、反覆咀嚼，也就是要經過思考與沉澱。"
   }
  ]
 },
 {
  "t": "黃永玉〈書和回憶〉",
  "p": "一艘夜航船載著一些鄉人，其中有位年輕秀才，自以為有學問所以多占了一點地盤。一個老和尚從岸上擠了進來，只好跟那些膽怯的鄉人縮在一道。／老和尚問年輕秀才：「請教，澹臺滅明是一個人還是兩個人？」「不看是四個字嗎？當然是兩個人！」年輕秀才回答。「那麼，」老和尚又問：「孔孟是一個人還是兩個人？」「不見是兩個字嗎？怎麼會是兩個人？當然是一個人！」秀才回答。這時老和尚自言自語地說：「哎喲！這下子我可以鬆鬆腿了！」他把蜷縮的雙腳大膽地伸開到年輕秀才那邊去了。／這是個很好的教訓。從年輕時代起，我就害怕有一對老和尚的腳伸到我這邊來。我總是處處小心。如今我也老了，卻總是提不起膽量去請教坐在對面的年輕秀才有關一個人或兩個人的學術問題。",
  "n": "（註：澹臺滅明是孔子的弟子，姓澹臺，名滅明；「孔孟」指孔子和孟子兩個人。）",
  "qs": [
   {
    "q": "根據本文，老和尚最後為什麼會伸開雙腳？",
    "o": [
     "年輕秀才把空間讓給他",
     "認為年長者應擁有更多空間",
     "趁年輕秀才睡著時偷偷伸展雙腳",
     "看出年輕秀才孤陋寡聞，不值得尊重"
    ],
    "a": 3,
    "e": "年輕秀才答錯了兩個問題，老和尚看出他學問不足，所以敢放心伸腿。"
   },
   {
    "q": "根據本文，作者害怕自己成為什麼樣子？",
    "o": [
     "堅守老舊觀念，難以接受新事物",
     "埋首苦讀，欠缺與人溝通的技巧",
     "知識水準低落，卻自負傲慢",
     "脫離現實，無法解決生活中的問題"
    ],
    "a": 2,
    "e": "作者怕像年輕秀才一樣，沒學問卻自以為了不起。"
   }
  ]
 }
];
const TIP = {
 "1": "先想整個詞語的意思，再找出要寫的那一個字。形近字（墊／摯、逐／遂）要看偏旁和字義。",
 "2": "先連最有把握的；再把解釋放回原本的詞語裡讀一讀，通不通順。",
 "3": "先看字音和字義，想出是哪一個字，寫在字形欄；再把字放進右邊的詞語，讀讀看通不通順。",
 "4": "歇後語：先想前半句的畫面，再選意思最接近的詞；譬喻：看「像」前後是不是把兩件不同的事物拿來比較。",
 "5": "先看成語拆開的字面意思（學／富／五／車），再把成語放回句子，確認意思通順。",
 "6": "回到課文那一句話；先刪掉明顯錯的選項；再用自己的話說一次句意。",
 "7": "先讀題目、再讀文章；把答案的線索用螢光筆畫起來；選項要在文中找得到證據。"
};
/* ===== 試卷組版（mode：stu 學生版、tch 教師版、live 互動版）===== */
const L = "ＡＢＣＤ", NO = "①②③④⑤⑥⑦⑧", ZH = "一二三四五六七";
const ak = (m, t) => m === "stu" ? "" : m === "tch" ? `<b class="a">${t}</b>` : `<b class="a rv">${t}</b>`;
const ex = (m, e) => m === "live" && e ? `<div class="rv ex2">💬 ${e}</div>` : "";
const it = (m, h, c = "") => `<div class="${m === "live" ? "it " : ""}${c}">${h}</div>`;
const sq = (m, t) => `<span class="sq">${ak(m, t)}</span>`;
const ops = o => o.map((t, j) => `<span class="op">（${L[j]}）${t}</span>`).join("");
const lines = s => s.replace(/／/g, "<br>");
const rot = (a, k) => a.map((_, i) => a[(i + k) % a.length]);
const wrap = (m, k, t, d, b) => `<div class="sx"><h2 class="sh">${ZH[k - 1]}、${t}<small>${d}</small>${m === "live" ? '<button class="tipb">💡 答題小錦囊</button>' : ""}</h2>${m === "live" ? `<div class="tip">${TIP[k]}</div>` : ""}${b}</div>`;
const paren = (m, t) => `（<span class="bk">${m === "stu" ? "" : ak(m, t)}</span>）`;
const SEC = {
  1: m => wrap(m, 1, "國字注音", "請寫出「　」中字的注音，或把注音寫成正確的國字。", `<div class="g2i">${TZY.map((z, i) => it(m, `${i + 1}. ${z[0]}${sq(m, z[1])}${ex(m, z[2])}`, "zy")).join("")}</div>`),
  2: m => { const r = rot(TN.map((_, i) => i), 3); return wrap(m, 2, "注釋連連看", "用線把左邊的詞語和右邊正確的解釋連起來。", TN.map((n, i) => it(m, `<div class="mt"><div class="ml">${NO[i]} ${n[0]}<i class="dot"></i></div><div class="mr"><i class="dot"></i>${TN[r[i]][1]} ${ak(m, NO[r[i]])}</div></div>`)).join("")); },
  3: m => wrap(m, 3, "形音義填空", "看字形選項，依字音、字義寫出字，再填入詞語（　）。", TX.map(g => `<div class="bank fx">字形選項：${rot(g.c.map(c => c[0]), 2).map(x => `<span>${x}</span>`).join("")}</div><table class="tx"><tr><th>字形</th><th>字音</th><th>字義</th><th>詞彙填空</th></tr>${g.c.map(c => `<tr class="${m === "live" ? "it" : ""}"><td class="c0">${sq(m, c[0])}</td><td>${c[1]}</td><td>${c[2]}</td><td class="vw">${c[3].replace("（　）", paren(m, c[0]))}</td></tr>`).join("")}</table>`).join("")),
  4: m => { const bank = x => x.map(w => `<span>${w}</span>`).join("");
    return wrap(m, 4, "應用練習", "（一）歇後語判別　（二）譬喻法大閱兵", `<div class="bank">（一）和「讀書」有關的歇後語，選出適合的詞語填入：${bank(TY1.b)}</div>${TY1.q.map((t, i) => it(m, `${i + 1}. ${t[0].replace("{}", `（<span class="bk" style="min-width:4.4em">${m === "stu" ? "" : ak(m, t[1])}</span>）`)}${ex(m, t[2])}`, "zy6")).join("")}<div class="bank" style="margin-top:2mm">（二）句中的「像」屬於譬喻的畫○，不屬於譬喻的畫╳。</div>${TY2.q.map((t, i) => it(m, `${paren(m, t[1])}${i + 1}. ${t[0]}${ex(m, t[2])}`, "zy6")).join("")}`); },
  5: m => { const w = TI.map(x => x[0]), o = [3, 0, 4, 2, 1]; return wrap(m, 5, "成語填空", "先看語意，從選項選出成語；再把成語填入例句。", `<div class="bank">成語選項：${rot(w, 2).map(x => `<span>${x}</span>`).join("")}</div><div>${TI.map((t, i) => it(m, `${i + 1}. ${t[1]}<span class="bl">${ak(m, t[0])}</span>`, "zy5")).join("")}</div><div class="sp">${o.map((k, i) => it(m, `${i + 1}. ${TI[k][2].replace("{}", `（<span class="bk12">${m === "stu" ? "" : ak(m, TI[k][0])}</span>）`)}`, "zy6")).join("")}</div>`); },
  6: m => wrap(m, 6, "選擇題", "每題只有一個答案，把代號填入（　）中。", `<div class="cl2">${TQ.map((x, i) => it(m, `<div class="qt">${paren(m, L[x.a])}${i + 1}. ${x.q}</div>${x.s ? `<div class="qs">課文：「${x.s.replace(/／/g, "　")}」</div>` : ""}<div>${ops(x.o)}</div>${ex(m, x.e)}`, "q")).join("")}</div>`),
  7: m => { let n = 0; return wrap(m, 7, "閱讀題組", "先讀文本，再回答問題。", `<div class="g2">${TR.map(g => `<div><div class="qt">${g.t}</div><div class="rp">${lines(g.p)}${g.n ? `<div class="nt">${g.n}</div>` : ""}</div>${g.qs.map(x => it(m, `<div class="qt">${paren(m, L[x.a])}${++n}. ${x.q}</div><div>${ops(x.o)}</div>${ex(m, x.e)}`, "q")).join("")}</div>`).join("")}</div>`); }
};
const SS = ["國字注音", "注釋連連看", "形音義填空", "應用練習", "成語填空", "選擇題", "閱讀題組"];
const CHECK = `<div class="ck"><div class="ckh"><b>我的學習檢核</b><span>寫完後，每個大題在方框裡打勾，30 秒就好</span></div><div class="ckg">${SS.map((x, i) => `<div class="ckb"><b>${ZH[i]}、${x}</b><div class="fc"><span><i class="cb"></i>很熟</span><span><i class="cb"></i>還好</span><span><i class="cb"></i>要練</span></div></div>`).join("")}</div></div>`;
const page = (n, b) => `<div class="tp"><div class="th"><h1>〈${LESSON.short}〉測驗</h1><span>姓名：<i></i></span></div><div class="tb">${b}</div><div class="tf">第 ${n} 頁　／　共 4 頁</div></div>`;
const g2 = (a, b) => `<div class="g2"><div>${a}</div><div>${b}</div></div>`;
const pages = m => { const S = k => SEC[k](m); return page(1, g2(S(1) + S(2), S(3))) + page(2, g2(S(4), S(5))) + page(3, S(6)) + page(4, S(7) + (m === "stu" ? CHECK : "")); };
const TCSS = `
.tp,.tp *{box-sizing:border-box}
.tp{width:353mm;height:249mm;background:#fff;color:#222;margin:12px auto;padding:8mm 12mm 6mm;overflow:hidden;font-family:"Noto Sans TC","jf-openhuninn-2.0","jf open 粉圓體","Microsoft JhengHei",sans-serif;font-size:13.7pt;line-height:1.5;display:flex;flex-direction:column;box-shadow:0 0 14px rgba(0,0,0,.45);break-after:page;page-break-after:always;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.tp:last-child{break-after:auto;page-break-after:auto}
.tp .th{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1.5pt solid #333;padding-bottom:1.5mm;margin-bottom:3mm}
.tp .th h1{font-size:19pt;font-weight:500;letter-spacing:.2em}.tp .th span{font-size:14pt}.tp .th i{display:inline-block;border-bottom:.8pt solid #222;width:70mm;height:1em}
.tp .tb{flex:1;min-height:0;overflow:hidden}
.tp .tf{text-align:center;font-size:10pt;color:#555;padding-top:1mm;border-top:.5pt solid #bbb}
.tp .g2{display:grid;grid-template-columns:1fr 1fr;gap:0 12mm;align-items:start}
.tp .g2i{display:grid;grid-template-columns:1fr 1fr;gap:0 6mm}
.tp h2{font-size:14.5pt;font-weight:500;letter-spacing:.1em;border-left:3pt solid #333;padding-left:2.5mm;margin:0 0 1.5mm}
.tp h2 small{font-size:10pt;font-weight:400;color:#555;letter-spacing:0;margin-left:3mm}
.tp .sx{margin-bottom:3mm}
.tp .zy{line-height:2.7;white-space:nowrap}
.tp .sq{display:inline-block;width:13mm;height:13mm;border:1pt solid #333;vertical-align:middle;text-align:center;line-height:12mm;margin-left:2mm;font-size:12pt;white-space:nowrap}
.tp .bk{display:inline-block;min-width:1.4em;text-align:center;border-bottom:.6pt solid #333}.tp .bk12{display:inline-block;min-width:12em;text-align:center}
.tp .bl{display:inline-block;min-width:34mm;border-bottom:.8pt solid #222;text-align:center;margin-left:2mm}
.tp .zy5{line-height:2.7}.tp .zy6{line-height:2.1}.tp .sp{margin-top:1.5mm;border-top:.5pt dashed #999;padding-top:1.5mm}
.tp .a{color:#B3261E;font-weight:500}
.tp .mt{display:grid;grid-template-columns:60mm 1fr;align-items:center;min-height:11mm;border-bottom:.4pt dotted #aaa;font-size:13pt;line-height:1.35}
.tp .ml{text-align:right;padding-right:2mm}.tp .dot{display:inline-block;width:3.2mm;height:3.2mm;border:.8pt solid #333;border-radius:50%;margin:0 2mm;vertical-align:middle}
.tp table{border-collapse:collapse;width:100%;font-size:10.5pt;margin-bottom:1mm}.tp td,.tp th{border:.5pt solid #555;padding:.3mm 1.5mm;text-align:left;font-weight:400}.tp th{font-weight:700}
.tp table.tx{table-layout:fixed;margin-bottom:1.8mm}.tp .bank.fx{margin:0 0 1mm;padding:.8mm 3mm;font-size:13.7pt}.tp .bank.fx span{margin-right:7mm;font-size:15pt}.tp .tx th:nth-child(1){width:19mm}.tp .tx th:nth-child(2){width:24mm}.tp .tx th:nth-child(4){width:50mm}.tp .tx td{font-size:12pt;line-height:1.4;vertical-align:middle}.tp .tx .vw{font-size:13.7pt}.tp .tx .sq{margin:0;width:11.5mm;height:11.5mm;line-height:10.5mm}.tp .tx td{padding:.2mm 1.5mm}.tp .tx .c0{text-align:center}
.tp .bank{border:.8pt solid #333;padding:1.2mm 3mm;margin-bottom:2mm;font-size:12.5pt}.tp .bank span{margin-right:5mm}
.tp .poem{border:.6pt solid #333;background:#fff;padding:1.5mm 3mm;font-size:12.5pt;line-height:1.45;margin:0 0 .5mm}.tp .ra{text-align:right;margin-bottom:1.5mm}
.tp .q{margin-bottom:2.2mm;break-inside:avoid}.tp .qt{font-weight:500}.tp .qs{border-left:2.5pt solid #333;background:#fff;padding:.3mm 2.5mm;margin:.5mm 0;font-size:12.5pt}.tp .op{display:inline-block;margin-right:3.5mm}
.tp .cl2{column-count:2;column-gap:12mm}
.tp .rp{border:.6pt solid #333;padding:1.5mm 3mm;text-align:justify;line-height:1.55;margin-bottom:1.5mm;font-size:13pt}.tp .nt{font-size:10.5pt;margin-top:.5mm}
.tp .rv,.tp .ex2{display:none}
.tp .it{cursor:pointer}.tp .it:hover{background:rgba(236,192,102,.15)}
.tp .it.open .rv{display:inline}.tp .it.open .rv.ex2{display:block;font-size:11pt;line-height:1.45;color:#333;background:#FFF8D6;padding:.8mm 2mm;margin:.5mm 0 1.5mm;white-space:normal}
.tp .tip{display:none}
.tp .ck{border-top:1.2pt dashed #555;margin-top:3mm;padding-top:2mm;font-size:11pt}.tp .ckh{display:flex;gap:6mm;align-items:baseline;margin-bottom:1.5mm}.tp .ckh span{font-size:10pt;color:#444}.tp .ckg{display:grid;grid-template-columns:repeat(7,1fr);gap:2mm}.tp .ckb{border:.6pt solid #555;padding:1mm 1.5mm;text-align:center;font-size:10.5pt;line-height:1.5}.tp .ckb b{display:block;font-weight:500}.tp .fc{font-size:9.5pt;white-space:nowrap}.tp .fc span{margin-right:2.2mm}.tp .fc span:last-child{margin-right:0}.tp .cb{display:inline-block;width:3.2mm;height:3.2mm;border:.7pt solid #222;vertical-align:-.5mm;margin-right:1mm}
@media print{.tp{margin:0!important;box-shadow:none!important;zoom:1!important}}`;
$("#tcss").textContent = TCSS + `
.live .tp{height:auto;min-height:249mm;zoom:var(--z,1)}.live .tp .tb{overflow:visible}
.live .tp .sh{cursor:pointer}.live .tp .tipb{background:#FFF3B0;border:1px solid #E0C34A;padding:1mm 3mm;font-size:10pt;margin-left:3mm}
.live .tp .tip{font-size:12pt;background:#FFF8D6;border-left:4px solid #D9AE4E;padding:1.5mm 3mm;margin:1mm 0 2mm}.live .tp .tip.on{display:block}`;
/* ===== 重點複習（翻牌＋答案詳解）===== */
const flip = (n, f, b) => `<div class="fl"><div class="fi"><div class="ff"><span class="nb">${n}</span><div>${f}</div></div><div class="fb"><span class="nb">${n}</span><div>${b}</div></div></div></div>`;
const rcard = (k, t, d, body) => `<section class="rc"><h2 class="sh" style="cursor:default">${ZH[k - 1]}、${t}<small>${d}</small></h2><div class="tip">💡 答題小錦囊：${TIP[k]}</div>${body}</section>`;
function buildReview() {
  const sx = k => SEC[k]("live").replace(/<h2 class="sh">.*?<\/h2>/, "").replace(/<div class="tip">.*?<\/div>/, "");
  const sxw = k => `<div class="sx live"><div class="tp" style="all:unset;display:block;font-family:inherit">${sx(k)}</div></div>`;
  return rcard(1, "國字注音", "點卡片翻面看答案與小叮嚀", `<div class="flg">${TZY.map((z, i) => flip(i + 1, z[0].replace("「", "<b>「").replace("」", "」</b>") + "<br>？", `<b>${z[1]}</b>${z[2]}`)).join("")}</div>`)
    + rcard(2, "注釋連連看", "點卡片翻面看解釋", `<div class="flg">${TN.map((n, i) => flip(i + 1, n[0], n[1])).join("")}</div>`)
    + rcard(3, "形音義填空", "點小題看答案", sxw(3)) + rcard(4, "應用練習", "點小題看答案與詳解", sxw(4))
    + rcard(5, "成語填空", "點卡片翻面看語意與例句", `<div class="flg">${TI.map((t, i) => flip(i + 1, t[0], `${t[1]}<br><small>${t[2].replace("{}", "<b style='font-size:1rem;display:inline'>" + t[0] + "</b>")}</small>`)).join("")}</div>`)
    + rcard(6, "選擇題", "點小題看答案與詳解", sxw(6)) + rcard(7, "閱讀題組", "點小題看答案與詳解", sxw(7));
}
/* ===== 介面 ===== */
const dl = (html, name) => { const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([html], { type: "text/html" })); a.download = name; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000); };
const doc = m => `<!DOCTYPE html><html lang="zh-Hant"><head><meta charset="UTF-8"><title>${LESSON.name} 測驗${m === "tch" ? "（教師版）" : ""}</title><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet"><style>body{margin:0;background:#4a463f}${TCSS}@page{size:353mm 250mm;margin:0}.bar{padding:8px;text-align:center}.bar button{padding:8px 16px;background:#322E2B;color:#ECC066;border:1px solid #D9AE4E;cursor:pointer}@media print{.bar{display:none}body{background:#fff}}</style></head><body><div class="bar"><button onclick="print()">🖨️ 列印（B4 橫式）</button></div>${pages(m)}</body></html>`;
const tabs = $("#tabs"), acts = $("#acts"), rv = $("#review"), pp = $("#paper"), note = $("#note");
const mk = (p, t, c, f) => { const b = document.createElement("button"); b.className = "b " + c; b.textContent = t; b.onclick = f; p.append(b); return b; };
function view(v) { rv.hidden = v !== 0; pp.hidden = v !== 1; t0.classList.toggle("on", v === 0); t1.classList.toggle("on", v === 1); fit();
  note.textContent = v === 0 ? "快速複習：點卡片翻面；點小題看答案與詳解；點大標題一次看整大題。" : "試卷互動版：點大標題＝顯示整大題答案；點小題＝只顯示該題答案與詳解；每大題有💡答題小錦囊。"; }
const t0 = mk(tabs, "📘 重點複習", "", () => view(0)), t1 = mk(tabs, "📝 測驗試卷", "", () => view(1));
mk(acts, "⛶ 全螢幕測驗", "g", () => { view(1); (pp.requestFullscreen || pp.webkitRequestFullscreen).call(pp); });
mk(acts, "⬇ 下載測驗（學生版）", "r", () => dl(doc("stu"), `${LESSON.name}_測驗_學生版.html`));
mk(acts, "⬇ 下載測驗（教師版）", "r", () => dl(doc("tch"), `${LESSON.name}_測驗_教師版.html`));
acts.insertAdjacentHTML("afterbegin", '<a class="b" href="2_06_fourreadingmethods.html" style="text-decoration:none">← 回電子書</a>');
rv.innerHTML = buildReview(); pp.innerHTML = pages("live");
function fit() { const w = document.fullscreenElement ? innerWidth - 24 : Math.min(innerWidth - 30, 1400); pp.style.setProperty("--z", Math.min(w / 1334, 1.5).toFixed(3)); }
addEventListener("resize", fit); document.addEventListener("fullscreenchange", fit);
document.addEventListener("click", e => {
  const h = e.target.closest(".sh"), s = h && h.closest(".sx");
  if (e.target.closest(".tipb")) { e.target.closest(".sx").querySelector(".tip").classList.toggle("on"); return; }
  if (h && s && h.closest(".tp")) { const its = [...s.querySelectorAll(".it")], all = its.every(i => i.classList.contains("open")); its.forEach(i => i.classList.toggle("open", !all)); return; }
  const i = e.target.closest(".it"); if (i) { i.classList.toggle("open"); return; }
  const f = e.target.closest(".fl"); if (f) f.classList.toggle("on");
});
view(0);
</script>
</body>
</html>
